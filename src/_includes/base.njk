---
cssFile: null
jsFile: null
codeStyles: false
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description or 'andrewhuang.cc - portfolio and blog of a robotics and engineering student.' }}">

    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@200;400;500;600;700&display=swap">

    <link rel="stylesheet" href="/css/global.css">
    {% if cssFile %}<link rel="stylesheet" href="/css/{{ cssFile }}">{% endif %}
    {% if codeStyles %}<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/github-dark.min.css">{% endif %}

    {% if codeStyles %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/highlight.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/languages/cpp.min.js" defer></script>
    <script>(() => { addEventListener('load', () => hljs.highlightAll()); })();</script>
    {% endif %}

    <script defer src="/js/theme.js"></script>
    <script defer src="/js/slideshow.js"></script>
    <script defer src="/js/lightbox.js"></script>
    <script defer src="/js/post-utils.js"></script>
    {% if jsFile %}<script defer src="/js/{{ jsFile }}"></script>{% endif %}

    <script>
        window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
        window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
    </script>
    <script defer src="/_vercel/insights/script.js"></script>
    <script defer src="/_vercel/speed-insights/script.js"></script>
</head>
<body>
    <a href="#main-content" class="skip-link">skip to content</a>
    {{ content | safe }}
</body>
</html>
