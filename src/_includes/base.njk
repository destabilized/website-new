<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description or 'andrewhuang.cc - portfolio and blog of a robotics and engineering student.' }}">

    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>

    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/blog-posts.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/github-dark.min.css">

    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/highlight.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/languages/cpp.min.js" defer></script>
    <script>(() => { addEventListener('load', () => hljs.highlightAll()); })();</script>

    <script defer src="/js/theme.js"></script>
    <script defer src="/js/slideshow.js"></script>
    <script defer src="/js/lightbox.js"></script>
    <script>
        window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
        window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
    </script>
    <script defer src="/_vercel/insights/script.js"></script>
    <script defer src="/_vercel/speed-insights/script.js"></script>
</head>
<body>
    <a href="#main-content" class="skip-link">skip to content</a>
    <main id="main-content">
        <div class="container">
            {% include "nav.njk" %}
            <div class="yap">
                {{ content | safe }}
            </div>
        </div>
    </main>
</body>
</html>